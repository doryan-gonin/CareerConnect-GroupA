{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vp preview",
    "test": "vp test --run --passWithNoTests",
    "test:watch": "vp test watch",
    "test:coverage": "vp test --run --coverage",
    "e2e": "vp exec playwright test",
    "e2e:ui": "vp exec playwright test --ui",
    "e2e:install": "vp exec playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "npm@11.20.0"
}
